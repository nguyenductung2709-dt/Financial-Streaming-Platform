# Optional local development overrides; copy to .env before first database startup.
POSTGRES_DB=financial_streaming
POSTGRES_USER=financial
POSTGRES_PASSWORD=financial_dev
POSTGRES_PORT=15432

# Materializer settings for tools that run on the host (the Python validation and flow
# scripts). The materializer container takes its database URL and brokers from
# compose.yaml; only MATERIALIZER_GROUP_ID is shared with it.
# Keep the URL in sync with any PostgreSQL overrides above.
MATERIALIZER_DATABASE_URL=postgresql://financial:financial_dev@localhost:15432/financial_streaming?sslmode=disable
MATERIALIZER_BROKERS=localhost:19092
MATERIALIZER_GROUP_ID=materializer

# Optional: publish a measurement stamp per committed result (measure-flow sets it).
# MATERIALIZER_STAMP_TOPIC=materialize-stamps
