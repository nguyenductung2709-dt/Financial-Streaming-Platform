#!/usr/bin/env bash
# Check-only pre-commit hook: verifies formatting and lint of staged service files.
# Never rewrites files. Activate once per clone with: make setup-hooks
# Missing tools are skipped with a warning; CI enforces the same checks.

set -u

staged=$(git diff --cached --name-only --diff-filter=ACM)

go_files=$(printf '%s\n' "$staged" | grep -E '^services/data-producer/.*\.go$' || true)
scala_files=$(printf '%s\n' "$staged" | grep -E '^services/streaming-processor/.*\.(scala|sbt)$' || true)

failed=0

if [[ -n "$go_files" ]]; then
  if ! command -v gofmt >/dev/null 2>&1; then
    echo "pre-commit: gofmt not found on PATH, skipping Go format check (CI still enforces it)." >&2
  else
    unformatted=$(printf '%s\n' "$go_files" | xargs gofmt -l)
    if [[ -n "$unformatted" ]]; then
      echo "pre-commit: gofmt found unformatted Go files:" >&2
      printf '%s\n' "$unformatted" >&2
      echo "Fix with: gofmt -w services/data-producer, then re-stage." >&2
      failed=1
    fi
  fi
  if ! command -v go >/dev/null 2>&1; then
    echo "pre-commit: go not found on PATH, skipping go vet (CI still enforces it)." >&2
  elif ! go vet ./services/data-producer; then
    echo "pre-commit: go vet failed for services/data-producer." >&2
    failed=1
  fi
fi

if [[ -n "$scala_files" ]]; then
  if ! command -v sbt >/dev/null 2>&1; then
    echo "pre-commit: sbt not found on PATH, skipping Scala format check (CI still enforces it)." >&2
  elif ! (cd services/streaming-processor && sbt scalafmtCheckAll scalafmtSbtCheck); then
    echo "pre-commit: scalafmt found unformatted Scala files." >&2
    echo "Fix with: make format-streaming-processor, then re-stage." >&2
    failed=1
  fi
fi

exit "$failed"