#!/usr/bin/env bash
# Format fully staged service files and check Go lint.
# Activate once per clone with: make setup-hooks
# Missing tools are skipped with a warning; CI enforces the same checks.
# Checks run against a snapshot of the index, so unstaged edits can't mask
# unformatted staged content.

set -u

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

staged=$(git diff --cached --name-only --diff-filter=ACMR)

go_files=$(printf '%s\n' "$staged" | grep -E '^services/data-producer/.*\.go$' || true)
scala_files=$(printf '%s\n' "$staged" | grep -E '^services/streaming-processor/.*\.(scala|sbt)$' || true)

if [[ -z "$go_files" && -z "$scala_files" ]]; then
  exit 0
fi

# Export the staged versions of all tracked files into a temporary tree.
snapshot=$(mktemp -d)
trap 'rm -rf "$snapshot"' EXIT
git checkout-index --all --prefix="$snapshot/" || exit 1
cd "$snapshot" || exit 1

failed=0

if [[ -n "$go_files" ]]; then
  if ! command -v gofmt >/dev/null 2>&1; then
    echo "pre-commit: gofmt not found on PATH, skipping Go format check (CI still enforces it)." >&2
  else
    if ! printf '%s\n' "$go_files" | xargs gofmt -w; then
      echo "pre-commit: Go formatting failed." >&2
      failed=1
    fi
  fi
  if ! command -v go >/dev/null 2>&1; then
    echo "pre-commit: go not found on PATH, skipping go vet (CI still enforces it)." >&2
  elif ! go vet ./services/data-producer; then
    echo "pre-commit: go vet failed for services/data-producer." >&2
    failed=1
  fi
fi

if [[ -n "$scala_files" ]]; then
  if ! command -v sbt >/dev/null 2>&1; then
    echo "pre-commit: sbt not found on PATH, skipping Scala format check (CI still enforces it)." >&2
  elif ! (cd services/streaming-processor && sbt scalafmtAll scalafmtSbt); then
    echo "pre-commit: Scala formatting failed." >&2
    echo "Fix with: make formatall, then re-stage." >&2
    failed=1
  fi
fi

if [[ "$failed" -ne 0 ]]; then
  exit "$failed"
fi

cd "$root" || exit 1
changed=()
while IFS= read -r file; do
  [[ -n "$file" ]] || continue
  if ! git show ":$file" | cmp -s - "$snapshot/$file"; then
    changed+=("$file")
  fi
done < <(printf '%s\n%s\n' "$go_files" "$scala_files")

if [[ ${#changed[@]} -eq 0 ]]; then
  exit 0
fi

# Check every candidate before copying anything back.
for file in "${changed[@]}"; do
  if ! git diff --quiet -- "$file"; then
    echo "pre-commit: $file needs formatting and has unstaged changes." >&2
    echo "Run make formatall, review, and stage the intended changes before committing." >&2
    echo "Your working files and staging area have not been changed by the hook." >&2
    exit 1
  fi
done

for file in "${changed[@]}"; do
  cp "$snapshot/$file" "$file" || exit 1
  git add -- "$file" || exit 1
  echo "pre-commit: formatted and re-staged $file"
done

exit 0
